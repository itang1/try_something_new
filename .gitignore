# Xcode user-specific files (do NOT commit these)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
DerivedData/
build/
*.o
*.d
*.dSYM/
*.ipa
*.hmap

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods (if ever added)
Pods/
*.xcworkspace

# Carthage (if ever added)
Carthage/Build/

# Fastlane (if ever added)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Credentials / secrets — never commit these
*.p12
*.mobileprovision
AuthKey_*.p8

# Expo / React Native
node_modules/
.expo/
/ios/
/android/

# Expo extras
.env*.local
expo-env.d.ts
dist/
.kotlin/
.metro-health-check*
*.jks
