{
  "name": "try-something-new-drive-times",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  // Each app launch asks for at most a few batches, so 30 a minute per IP leaves plenty of room for real people.
  // namespace_id is any number unique to this account's rate limiters.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    // Location search asks once a pause in typing, so a search is a handful of requests.
    {
      "name": "PLACES_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    // Place reports open GitHub issues, so a few a minute is plenty.
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Where place reports go. The token is a secret: `npx wrangler secret put GITHUB_TOKEN`.
  "vars": { "GITHUB_REPO": "itang1/try_something_new" }
}
