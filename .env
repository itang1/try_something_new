# Public settings. Secrets go in .env.local, which git ignores.
EXPO_PUBLIC_CATALOG_URL=https://itang1.github.io/try_something_new
# The drive-times Worker in server/drive-times: travel times, address suggestions and place reports. Not secret.
# Changing it needs a new development build.
EXPO_PUBLIC_ROUTING_URL=https://try-something-new-drive-times.trysomethingnew.workers.dev
# Crash reports go to Sentry when EXPO_PUBLIC_SENTRY_DSN is set (in .env.local or the EAS environment).
